{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8787} {
			header_up X-Nexa-Client-IP {client_ip}
		}
	}
	handle {
		root * "{$WEB_ROOT:/srv/nexatech}"
		try_files {path} /index.html
		file_server
	}
}
