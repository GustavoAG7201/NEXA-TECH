# Copiar a deploy/.env y restringir el archivo al propietario.
APP_DOMAIN=
NEXA_OWNER_PASSWORD=
# postgresql://nexa_runtime:<contraseña-hex-aleatoria>@db:5432/nexatech
DATABASE_URL=
# Ruta absoluta a la carpeta privada de respaldos, o usar el valor predeterminado.
NEXA_HANDOFF_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# Datos públicos, únicamente después de validarlos administrativamente.
LEGAL_RESPONSIBLE=
LEGAL_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_SUPPORT_PHONE=
