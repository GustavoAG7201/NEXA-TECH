# El instalador local genera ambas URL con contraseñas aleatorias.
DATABASE_URL=
NEXATECH_OWNER_URL=
NEXATECH_LOCAL_PG_PORT=55432
# Si PostgreSQL no está en PATH, apunta a su directorio bin.
NEXATECH_PG_BIN=

APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8787
TRUST_PROXY=0

# Opcional. El envío queda inactivo hasta configurar un servidor SMTP real.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true

# Datos públicos opcionales. En blanco se usa la configuración de NexaTech.
LEGAL_PROVIDER=
LEGAL_RESPONSIBLE=
LEGAL_ADDRESS=
LEGAL_PRIVACY_CONTACT=
LEGAL_PRIVACY_EMAIL=
LEGAL_PRIVACY_PHONE=
LEGAL_SUPPORT_EMAIL=
LEGAL_SUPPORT_PHONE=
