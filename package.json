{
  "name": "nexatech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:local": "npm run dev",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:frontend": "vite",
    "start": "node server/index.mjs",
    "local:setup": "node scripts/local-db.mjs setup",
    "local:start": "node scripts/local-db.mjs start",
    "local:stop": "node scripts/local-db.mjs stop",
    "db:init": "node --env-file-if-exists=.env scripts/database.mjs init",
    "db:prepare": "node --env-file-if-exists=.env scripts/database.mjs prepare",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:verify": "node --env-file-if-exists=.env scripts/database.mjs verify",
    "db:backup": "node --env-file-if-exists=.env scripts/database.mjs backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database.mjs restore",
    "admin:first": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test:local": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/standalone-api.test.mjs tests/standalone-checkout.test.mjs tests/standalone-operations.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
